# Copy this file to `.env` and adjust values. Never commit `.env`.

# --- Application ---
APP_NAME="AgentForge AI"
APP_ENV=development          # development | test | production
LOG_LEVEL=INFO

# --- Storage ---
DATABASE_URL=sqlite:///./agentforge.db
CHECKPOINT_DB_PATH=./checkpoints.db          # LangGraph checkpoints (paused workflows)
GENERATED_PROJECTS_DIR=../generated_projects # generated code & documents

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20

# --- Authentication (off = every request acts as a built-in demo admin) ---
AUTH_ENABLED=false
JWT_SECRET=                  # required when AUTH_ENABLED=true in production
JWT_EXPIRE_MINUTES=480

# --- LLM (any OpenAI-compatible Chat Completions API) ---
# Leave LLM_API_KEY empty to run in clearly-labelled MOCK mode (rule-based, no LLM).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8000
LLM_MAX_TOKENS_PARAM=max_tokens   # some newer models need: max_completion_tokens
LLM_TEMPERATURE=0.2               # set to "none" for models that reject temperature
# Prices (USD per 1M tokens) used only to ESTIMATE cost from real token counts.
# Check your provider's current pricing before relying on these numbers.
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

# --- Mock-mode demo ---
MOCK_INJECT_DEFECT=true      # first code version gets one labelled defect → shows correction loop
RESEARCH_CHECK_URLS=false    # true = probe suggested https URLs (reachability only)

# --- Test sandbox (generated code never runs on the host) ---
SANDBOX_MODE=auto            # auto | docker | disabled
SANDBOX_IMAGE=agentforge-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
